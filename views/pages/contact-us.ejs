       <script nonce="<%= nonce %>" type="module">
          import { submitContactMessage } from '/js/firebaseConfig.js';

          function clearErrors() {
             document.querySelectorAll('.error_msg').forEach(function(el) {
                el.style.display = 'none';
             });
          }

          function showError(elementId, errorMessage) {
             var inputEl = document.getElementById(elementId);
             if (inputEl) {
                var container = inputEl.closest('.input_container');
                if (container) {
                   var errorEl = container.querySelector('.error_msg');
                   if (errorEl) {
                      errorEl.textContent = errorMessage;
                      errorEl.style.display = 'block';
                   }
                }
             }
          }

          function validateContactForm() {
             clearErrors();
             var isValid = true;

             var firstName = document.getElementById('First_Name').value.trim();
             if (!firstName) {
                showError('First_Name', 'Please Enter First Name');
                isValid = false;
             }

             var lastName = document.getElementById('Last_Name').value.trim();
             if (!lastName) {
                showError('Last_Name', 'Please Enter Last Name');
                isValid = false;
             }

             var email = document.getElementById('Email_ID').value.trim();
             var emailReg = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
             if (!email) {
                showError('Email_ID', 'Please Enter Email ID');
                isValid = false;
             } else if (!emailReg.test(email)) {
                showError('Email_ID', 'Please Enter a Valid Email ID');
                isValid = false;
             }

             var city = document.getElementById('City').value.trim();
             if (!city) {
                showError('City', 'Please Enter City');
                isValid = false;
             }

             var purposeChecked = document.querySelector('input[name="radios_option_purpose"]:checked');
             var purposeVal = purposeChecked ? purposeChecked.value : '';
             if (!purposeVal) {
                var purposeBox = document.querySelector('.radios-box');
                if (purposeBox) {
                   var err = purposeBox.querySelector('.error_msg');
                   if (!err) {
                      err = document.createElement('span');
                      err.className = 'error_msg';
                      err.style.color = '#ba1a1a';
                      err.style.fontSize = '12px';
                      err.style.display = 'block';
                      purposeBox.appendChild(err);
                   }
                   err.textContent = 'Please select a purpose';
                   err.style.display = 'block';
                }
                isValid = false;
             }

             var productType = document.getElementById('Product_Type').value;
             if ((purposeVal === 'Enquiry' || purposeVal === 'Service') && !productType) {
                showError('Product_Type', 'Please Select Product Type');
                isValid = false;
             }

             var message = document.getElementById('Message').value.trim();
             if (!message) {
                showError('Message', 'Please Enter Message');
                isValid = false;
             }

             return isValid;
          }

          var submitBtn = document.getElementById('btn-submit-contact');
          var contactForm = document.getElementById('contactform');

          if (contactForm) {
             contactForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                if (!validateContactForm()) {
                   return;
                }

                var purposeChecked = document.querySelector('input[name="radios_option_purpose"]:checked');
                var purposeVal = purposeChecked ? purposeChecked.value : '';
                var productType = document.getElementById('Product_Type').value;

                var messageData = {
                   first_name: document.getElementById('First_Name').value.trim(),
                   last_name: document.getElementById('Last_Name').value.trim(),
                   email_id: document.getElementById('Email_ID').value.trim(),
                   city: document.getElementById('City').value.trim(),
                   radios_option_purpose: purposeVal,
                   message: document.getElementById('Message').value.trim()
                };

                if (productType) {
                   messageData.product_type = productType;
                }

                var originalBtnText = submitBtn.innerHTML;
                try {
                   submitBtn.disabled = true;
                   submitBtn.innerHTML = '<span class="txt">Submitting...</span>';

                   await submitContactMessage(messageData);

                   $('#submit-popup').modal('show');

                   contactForm.reset();
                   clearErrors();
                } catch (error) {
                   console.error("Error submitting contact form:", error);
                   var formStatus = document.getElementById('contact-form-status');
                   if (!formStatus) {
                       formStatus = document.createElement('div');
                       formStatus.id = 'contact-form-status';
                       formStatus.className = 'alert alert-danger mt-3';
                       contactForm.appendChild(formStatus);
                   }
                   formStatus.innerHTML = 'There was an error sending your message. Please try again or email us directly at info@credifycapital.in';
                } finally {
                   submitBtn.disabled = false;
                   submitBtn.innerHTML = originalBtnText;
                }
             });
          }
       </script>

<!-- Submit Success Modal -->
<div class="modal fade custom-modal" id="submit-popup" tabindex="-1" role="dialog" aria-hidden="true">
   <div class="modal-dialog modal-dialog-centered" role="document">
