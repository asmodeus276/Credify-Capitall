<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="#142450">
  <meta name="description" content="Contact Credify Capital customer care team for instant loan support, queries, and business assistance. Email: info@credifycapital.in | Helpline: +91 9931372218.">
  <title>Contact Us | Credify Capital Customer Support</title>
  <link rel="shortcut icon" href="/img/favicon.ico">

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind-built.css">
</head>

<body class="bg-background text-on-background font-body-md pt-[64px] lg:pt-[116px]">
  <%- include('../partials/header') %>

  <!-- START BANNER -->
  <section class="relative bg-primary text-white py-14 px-4 md:px-8 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-secondary/15 via-transparent to-transparent opacity-60"></div>
    
    <div class="max-w-6xl mx-auto relative z-10 text-center md:text-left">
      <div class="inline-flex items-center gap-2 bg-white/10 text-white/90 px-3.5 py-1 rounded-full text-xs font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Fast Support &amp; Assistance
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-3">
        Contact <span class="text-secondary">Credify Capital</span>
      </h1>
      <p class="text-sm md:text-base text-white/85 max-w-2xl leading-relaxed mb-4 font-light">
        Have questions about loan eligibility, interest rates, or your application status? Connect with our dedicated support team.
      </p>
      
      <!-- Breadcrumbs -->
      <div class="flex items-center justify-center md:justify-start gap-2 text-xs text-white/70">
        <a href="/index.html" class="hover:text-white transition">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-white font-semibold">Contact Us</span>
      </div>
    </div>
  </section>
  <!-- END BANNER -->

  <main class="py-12 md:py-16">
    <div class="px-margin-mobile md:px-margin-desktop w-full max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left: Contact Form Card (7 cols) -->
        <div class="lg:col-span-7 bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-outline-variant/30">
          
          <div class="mb-6 border-b border-outline-variant/20 pb-4">
            <h2 class="text-2xl font-bold text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">support_agent</span>
              Send Us a Message
            </h2>
            <p class="text-xs md:text-sm text-on-surface-variant mt-1">
              Fill in the form below and an official Credify credit officer will get back to you shortly.
            </p>
          </div>

          <!-- Form Element -->
          <form id="contact-form" class="space-y-4" novalidate>

            <!-- Name Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="first_name" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                  First Name <span class="text-error">*</span>
                </label>
                <input type="text" id="first_name" name="first_name" required
                  placeholder="e.g. Rahul"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all" />
                <p class="text-xs text-error hidden mt-1" data-error-for="first_name">Please enter your first name.</p>
              </div>

              <div>
                <label for="last_name" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                  Last Name <span class="text-error">*</span>
                </label>
                <input type="text" id="last_name" name="last_name" required
                  placeholder="e.g. Sharma"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all" />
                <p class="text-xs text-error hidden mt-1" data-error-for="last_name">Please enter your last name.</p>
              </div>
            </div>

            <!-- Email and City -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email_id" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                  Email Address <span class="text-error">*</span>
                </label>
                <input type="email" id="email_id" name="email_id" required
                  placeholder="you@example.com"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all" />
                <p class="text-xs text-error hidden mt-1" data-error-for="email_id">Please enter a valid email address.</p>
              </div>

              <div>
                <label for="city" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                  City <span class="text-error">*</span>
                </label>
                <input type="text" id="city" name="city" required
                  placeholder="e.g. Ghaziabad / Delhi"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all" />
                <p class="text-xs text-error hidden mt-1" data-error-for="city">Please enter your city.</p>
              </div>
            </div>

            <!-- Purpose Selection -->
            <div>
              <label class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                Purpose of Contact <span class="text-error">*</span>
              </label>
              <div class="grid grid-cols-3 gap-3" id="purpose-group">
                <label class="flex items-center justify-center gap-2 p-2.5 border border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-slate-50 transition text-xs font-medium has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:text-primary has-[:checked]:font-bold">
                  <input type="radio" name="radios_option_purpose" value="Enquiry" checked class="text-primary focus:ring-primary" />
                  <span>Enquiry</span>
                </label>
                <label class="flex items-center justify-center gap-2 p-2.5 border border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-slate-50 transition text-xs font-medium has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:text-primary has-[:checked]:font-bold">
                  <input type="radio" name="radios_option_purpose" value="Service" class="text-primary focus:ring-primary" />
                  <span>Service</span>
                </label>
                <label class="flex items-center justify-center gap-2 p-2.5 border border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-slate-50 transition text-xs font-medium has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:text-primary has-[:checked]:font-bold">
                  <input type="radio" name="radios_option_purpose" value="Other" class="text-primary focus:ring-primary" />
                  <span>Other</span>
                </label>
              </div>
              <p class="text-xs text-error hidden mt-1" data-error-for="radios_option_purpose">Please choose a purpose.</p>
            </div>

            <!-- Product Type Selection -->
            <div id="product-type-container">
              <label for="product_type" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                Interested Product
              </label>
              <select id="product_type" name="product_type"
                class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all bg-white">
                <option value="Personal Loan">Personal Loan</option>
                <option value="Business Loan">Business Loan</option>
                <option value="Professional Loan">Professional Loan</option>
                <option value="Working Capital">Working Capital</option>
                <option value="Machinery Loan">Machinery Loan</option>
                <option value="Medical Equipment Loan">Medical Equipment Loan</option>
                <option value="Loan Against Property">Loan Against Property</option>
                <option value="Car Loan">Car Loan</option>
                <option value="General Enquiry">General / Other</option>
              </select>
            </div>

            <!-- Message Box -->
            <div>
              <label for="message" class="block text-xs font-semibold text-primary uppercase tracking-wider mb-1.5">
                Your Message <span class="text-error">*</span>
              </label>
              <textarea id="message" name="message" rows="4" required
                placeholder="Write your loan requirement, question, or feedback here..."
                class="w-full px-3.5 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-sm transition-all"></textarea>
              <p class="text-xs text-error hidden mt-1" data-error-for="message">Please enter your message.</p>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button type="submit" id="btn-submit-contact"
                class="w-full bg-primary hover:bg-opacity-95 text-white py-3.5 rounded-xl font-bold text-sm shadow-md transition-all active:scale-[0.99] flex items-center justify-center gap-2">
                <span>Submit Message</span>
                <span class="material-symbols-outlined text-sm">send</span>
              </button>
            </div>

            <!-- Error Banner -->
            <div id="contact-form-error" class="hidden p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl"></div>
          </form>

          <!-- In-place Success State -->
          <div id="contact-success-card" class="hidden py-8 px-4 text-center space-y-4">
            <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner">
              <span class="material-symbols-outlined text-4xl">check_circle</span>
            </div>
            <h3 class="text-2xl font-bold text-primary">Thank You!</h3>
            <p class="text-sm text-on-surface-variant max-w-md mx-auto leading-relaxed">
              Your message has been sent successfully. An official representative from <strong>Credify Capital</strong> will review your details and reach out to you shortly.
            </p>
            <div class="pt-2">
              <button type="button" id="btn-send-another"
                class="inline-flex items-center gap-2 border border-primary/20 text-primary hover:bg-primary/5 px-6 py-2.5 rounded-xl text-xs font-bold transition">
                <span class="material-symbols-outlined text-sm">refresh</span>
                Send Another Message
              </button>
            </div>
          </div>

        </div>

        <!-- Right: Contact Information & Map (5 cols) -->
        <div class="lg:col-span-5 space-y-6">

          <!-- Office Details Card -->
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-outline-variant/30 space-y-5">
            <h3 class="text-xl font-bold text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              Headquarters &amp; Support
            </h3>

            <div class="space-y-4 text-xs md:text-sm">
              <!-- Address -->
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-lg">apartment</span>
                </div>
                <div>
                  <p class="font-bold text-primary">Office Address</p>
                  <p class="text-on-surface-variant leading-relaxed">
                    1107, S3 Tower, Cloud9, Vaishali, Ghaziabad (NCR), 201010
                  </p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-3 pt-3 border-t border-outline-variant/15">
                <div class="w-9 h-9 rounded-lg bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-lg">mail</span>
                </div>
                <div>
                  <p class="font-bold text-primary">Official Email</p>
                  <a href="mailto:info@credifycapital.in" class="text-secondary font-semibold hover:underline">
                    info@credifycapital.in
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-3 pt-3 border-t border-outline-variant/15">
                <div class="w-9 h-9 rounded-lg bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-lg">call</span>
                </div>
                <div>
                  <p class="font-bold text-primary">Helpline &amp; WhatsApp</p>
                  <a href="tel:+919931372218" class="text-primary font-semibold hover:underline">
                    +91 9931372218
                  </a>
                </div>
              </div>

              <!-- Working Hours -->
              <div class="flex items-start gap-3 pt-3 border-t border-outline-variant/15">
                <div class="w-9 h-9 rounded-lg bg-primary/5 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-lg">schedule</span>
                </div>
                <div>
                  <p class="font-bold text-primary">Operating Hours</p>
                  <p class="text-on-surface-variant">
                    Monday – Saturday: 9:30 AM – 6:30 PM (IST)
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Embedded Map -->
          <div class="bg-white p-2 rounded-2xl shadow-lg border border-outline-variant/30 overflow-hidden">
            <iframe 
              src="https://maps.google.com/maps?q=1107,+S3+Tower,+Cloud9,+Vaishali+(GZB),+201010&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=&amp;output=embed" 
              width="100%" 
              height="260" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              class="rounded-xl">
            </iframe>
          </div>

        </div>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <!-- Form Controller -->
  <script nonce="<%= nonce %>">
    (function () {
      var contactForm = document.getElementById('contact-form');
      var successCard = document.getElementById('contact-success-card');
      var submitBtn = document.getElementById('btn-submit-contact');
      var formError = document.getElementById('contact-form-error');
      var btnSendAnother = document.getElementById('btn-send-another');

      function clearErrors() {
        if (formError) {
          formError.textContent = '';
          formError.classList.add('hidden');
        }
        contactForm.querySelectorAll('[data-error-for]').forEach(function (el) {
          el.classList.add('hidden');
        });
        contactForm.querySelectorAll('input, textarea, select').forEach(function (el) {
          el.classList.remove('border-error');
        });
      }

      function showError(fieldName) {
        var errEl = contactForm.querySelector('[data-error-for="' + fieldName + '"]');
        if (errEl) errEl.classList.remove('hidden');
        var inputEl = contactForm.querySelector('[name="' + fieldName + '"]');
        if (inputEl) inputEl.classList.add('border-error');
      }

      function validate() {
        clearErrors();
        var isValid = true;

        var firstName = contactForm.first_name.value.trim();
        if (!firstName) { showError('first_name'); isValid = false; }

        var lastName = contactForm.last_name.value.trim();
        if (!lastName) { showError('last_name'); isValid = false; }

        var email = contactForm.email_id.value.trim();
        var emailReg = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailReg.test(email)) { showError('email_id'); isValid = false; }

        var city = contactForm.city.value.trim();
        if (!city) { showError('city'); isValid = false; }

        var message = contactForm.message.value.trim();
        if (!message) { showError('message'); isValid = false; }

        return isValid;
      }

      if (contactForm) {
        contactForm.addEventListener('submit', async function (e) {
          e.preventDefault();

          if (!validate()) {
            return;
          }

          var purposeChecked = contactForm.querySelector('input[name="radios_option_purpose"]:checked');
          var purposeVal = purposeChecked ? purposeChecked.value : 'Enquiry';
          var productType = contactForm.product_type ? contactForm.product_type.value : '';

          var payload = {
            first_name: contactForm.first_name.value.trim(),
            last_name: contactForm.last_name.value.trim(),
            email_id: contactForm.email_id.value.trim(),
            city: contactForm.city.value.trim(),
            radios_option_purpose: purposeVal,
            product_type: productType,
            message: contactForm.message.value.trim()
          };

          var originalBtnHTML = submitBtn.innerHTML;

          try {
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Sending... <span class="material-symbols-outlined animate-spin inline-block align-middle ml-1 text-sm">autorenew</span>';

            var response = await fetch('/api/submit-contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            var result = await response.json();
            if (!response.ok) {
              throw new Error(result.error || 'Failed to send message.');
            }

            // Success Transition
            contactForm.reset();
            clearErrors();
            contactForm.classList.add('hidden');
            successCard.classList.remove('hidden');

          } catch (err) {
            console.error('Contact submission error:', err);
            if (formError) {
              formError.textContent = err.message || 'There was an error sending your message. Please try again or email us directly at info@credifycapital.in';
              formError.classList.remove('hidden');
            }
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHTML;
          }
        });
      }

      if (btnSendAnother) {
        btnSendAnother.addEventListener('click', function () {
          successCard.classList.add('hidden');
          contactForm.classList.remove('hidden');
          clearErrors();
        });
      }
    })();
  </script>
</body>

</html>