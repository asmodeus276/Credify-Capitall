<!DOCTYPE html><html class="light scroll-smooth" lang="en"><head>
<script nonce="<%= nonce %>" src="/js/jquery-3.6.0.min.js"></script>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Plan your repayments instantly with our Personal Loan EMI Calculator">
  <title>Personal Loan EMI Calculator - Credify Capital</title>
  <link rel="shortcut icon" href="/img/favicon.ico">

  <link rel="stylesheet" href="/css/loan-page-common.css">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/tailwind-built.css">

</head>
<body class="bg-background text-on-background font-body-md pt-[64px] lg:pt-[116px]">

<%- include('../partials/header') %>

<main style="padding-top: 108px;">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#142450] to-[#253A71] text-white py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-3">Personal Loan EMI Calculator</h1>
      <p class="text-white/80 text-lg">Calculate your Equated Monthly Installment in seconds</p>
    </div>
  </section>

  <!-- Calculator -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

        <!-- Inputs -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-primary mb-6">Loan Details</h2>

          <!-- Loan Amount -->
          <div class="mb-6">
            <div class="flex justify-between items-center mb-2">
              <label class="text-sm font-semibold text-gray-600">Loan Amount</label>
              <span class="text-primary font-bold text-lg" id="amount-display">₹5,00,000</span>
            </div>
            <input type="range" id="loan-amount" min="10000" max="10000000" step="10000" value="500000">
            <div class="flex justify-between text-xs text-gray-400 mt-1"><span>₹10K</span><span>₹1Cr</span></div>
          </div>

          <!-- Interest Rate -->
          <div class="mb-6">
            <div class="flex justify-between items-center mb-2">
              <label class="text-sm font-semibold text-gray-600">Interest Rate (p.a.)</label>
              <span class="text-primary font-bold text-lg" id="rate-display">12%</span>
            </div>
            <input type="range" id="interest-rate" min="5" max="30" step="0.5" value="12">
            <div class="flex justify-between text-xs text-gray-400 mt-1"><span>5%</span><span>30%</span></div>
          </div>

          <!-- Tenure -->
          <div class="mb-8">
            <div class="flex justify-between items-center mb-2">
              <label class="text-sm font-semibold text-gray-600">Loan Tenure</label>
              <span class="text-primary font-bold text-lg" id="tenure-display">24 months</span>
            </div>
            <input type="range" id="tenure" min="6" max="240" step="6" value="24">
            <div class="flex justify-between text-xs text-gray-400 mt-1"><span>6 months</span><span>20 years</span></div>
          </div>

          <a href="/apply.html" class="block w-full bg-secondary text-white text-center py-4 rounded-xl font-bold hover:brightness-110 transition-all shadow-md">
            Apply for This Loan
          </a>
        </div>

        <!-- Results -->
        <div>
          <!-- Summary Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="bg-primary text-white rounded-2xl p-5 text-center shadow-lg">
              <p class="text-xs text-white/70 font-semibold uppercase tracking-wider mb-1">Monthly EMI</p>
              <p class="text-2xl font-bold" id="emi-result">₹23,537</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center shadow">
              <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mb-1">Total Interest</p>
              <p class="text-2xl font-bold text-secondary" id="interest-result">₹64,880</p>
            </div>
            <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center shadow">
              <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mb-1">Total Payment</p>
              <p class="text-2xl font-bold text-gray-700" id="total-result">₹5,64,880</p>
            </div>
          </div>

          <!-- Donut Chart -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col items-center">
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-4">Breakup</h3>
            <div class="relative w-48 h-48">
              <svg viewBox="0 0 120 120" class="w-full h-full -rotate-90">
                <circle cx="60" cy="60" r="50" fill="none" stroke="#dce9ff" stroke-width="18"></circle>
                <circle id="interest-arc" cx="60" cy="60" r="50" fill="none" stroke="#b61722" stroke-width="18" stroke-dasharray="50 264" stroke-dashoffset="0" class="donut-ring"></circle>
                <circle id="principal-arc" cx="60" cy="60" r="50" fill="none" stroke="#142450" stroke-width="18" stroke-dasharray="200 264" stroke-dashoffset="-50" class="donut-ring"></circle>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <p class="text-xs text-gray-500">EMI</p>
                <p class="text-lg font-bold text-primary" id="donut-emi">₹23,537</p>
              </div>
            </div>
            <div class="flex gap-6 mt-4 text-xs font-semibold">
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-primary inline-block"></span> Principal</span>
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-secondary inline-block"></span> Interest</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Amortization Table -->
      <div class="mt-10 bg-white rounded-2xl shadow border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
          <h2 class="text-lg font-bold text-primary">Amortization Schedule</h2>
          <p class="text-sm text-gray-500 mt-1">Month-by-month breakdown of your repayments</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Month</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">EMI</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Principal</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Interest</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Balance</th>
              </tr>
            </thead>
            <tbody id="amort-table" class="divide-y divide-gray-50">
              <!-- Rows injected by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

<script nonce="<%= nonce %>">
const fmt = n => '₹' + Math.round(n).toLocaleString('en-IN');

function calcEMI(P, annualR, months) {
  if (annualR === 0) return P / months;
  const r = annualR / 12 / 100;
  return P * r * Math.pow(1 + r, months) / (Math.pow(1 + r, months) - 1);
}

function update() {
  const P = +document.getElementById('loan-amount').value;
  const R = +document.getElementById('interest-rate').value;
  const N = +document.getElementById('tenure').value;

  document.getElementById('amount-display').textContent = fmt(P);
  document.getElementById('rate-display').textContent = R + '%';
  document.getElementById('tenure-display').textContent = N >= 12 ? (N/12).toFixed(N%12===0?0:1) + ' yr' + (N===12?'':'s') : N + ' months';

  const emi = calcEMI(P, R, N);
  const total = emi * N;
  const interest = total - P;

  document.getElementById('emi-result').textContent = fmt(emi);
  document.getElementById('interest-result').textContent = fmt(interest);
  document.getElementById('total-result').textContent = fmt(total);
  document.getElementById('donut-emi').textContent = fmt(emi);

  // Donut update
  const circumference = 2 * Math.PI * 50; // 314.16
  const interestPct = interest / total;
  const interestDash = interestPct * circumference;
  const principalDash = (1 - interestPct) * circumference;
  document.getElementById('interest-arc').setAttribute('stroke-dasharray', `${interestDash} ${circumference}`);
  document.getElementById('principal-arc').setAttribute('stroke-dasharray', `${principalDash} ${circumference}`);
  document.getElementById('principal-arc').setAttribute('stroke-dashoffset', `-${interestDash}`);

  // Amortization
  let bal = P;
  const tbody = document.getElementById('amort-table');
  tbody.innerHTML = '';
  const rows = Math.min(N, 60); // cap at 60 rows for perf
  for (let m = 1; m <= rows; m++) {
    const intPart = bal * (R / 12 / 100);
    const prinPart = emi - intPart;
    bal = Math.max(0, bal - prinPart);
    const tr = document.createElement('tr');
    tr.className = m % 2 === 0 ? 'bg-gray-50/50' : '';
    tr.innerHTML = `<td class="px-4 py-2 text-gray-700">${m}</td>
      <td class="px-4 py-2 text-right text-gray-700">${fmt(emi)}</td>
      <td class="px-4 py-2 text-right text-primary font-medium">${fmt(prinPart)}</td>
      <td class="px-4 py-2 text-right text-secondary font-medium">${fmt(intPart)}</td>
      <td class="px-4 py-2 text-right text-gray-500">${fmt(bal)}</td>`;
    tbody.appendChild(tr);
  }
  if (N > 60) {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td colspan="5" class="px-4 py-3 text-center text-xs text-gray-400">Showing first 60 of ${N} months</td>`;
    tbody.appendChild(tr);
  }
}

['loan-amount','interest-rate','tenure'].forEach(id => {
  document.getElementById(id).addEventListener('input', update);
});
update();
</script>

</body></html>