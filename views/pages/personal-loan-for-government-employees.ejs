  <script>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuPanel = document.getElementById('mobile-menu-panel');
    const mobileMenuIcon = document.getElementById('mobile-menu-icon');

    if (mobileMenuBtn && mobileMenuPanel) {
      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileMenuPanel.classList.contains('hidden');
        if (isHidden) {
          mobileMenuPanel.classList.remove('hidden');
          if (mobileMenuIcon) mobileMenuIcon.textContent = 'close';
        } else {
          mobileMenuPanel.classList.add('hidden');
          if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
        }
      });
    }

    // Dynamic Calculator for Government Employee Loan
    const amtRange = document.getElementById('amt-range');
    const tenureRange = document.getElementById('tenure-range');
    const amtLabel = document.getElementById('amt-label');
    const tenureLabel = document.getElementById('tenure-label');
    const emiVal = document.getElementById('emi-val');

    function calculateEMI() {
      const p = parseFloat(amtRange.value);
      const n = parseFloat(tenureRange.value);
      const r = 10.25 / 12 / 100; // 10.25% p.a.
      
      // EMI = [P x r x (1+r)^n]/[((1+r)^n)-1]
      const emi = (p * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      
      // Format to Indian Currency
      const formattedEmi = new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(emi);
      
      const formattedAmt = new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(p);

      amtLabel.textContent = formattedAmt;
      tenureLabel.textContent = n + ' Months';
      emiVal.textContent = formattedEmi;
    }

    if (amtRange && tenureRange) {
      amtRange.addEventListener('input', calculateEMI);
      tenureRange.addEventListener('input', calculateEMI);
      calculateEMI();
    }
  </script>
