<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#253A71">
  <title>Admin CRM & Bank Portal - Credify Capital</title>
  <link rel="shortcut icon" href="/img/favicon.ico">
  
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind-built.css">
</head>
<body class="bg-slate-50 text-primary min-h-screen flex flex-col justify-between font-sans">

  <!-- TOP APP NAV BAR -->
  <%- include('../partials/header') %>

  <!-- MAIN WORKSPACE -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 md:px-8 py-8 space-y-6">
    
    <!-- ADMIN HEADER & CONTROLS -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl p-6 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full">
            <span class="material-symbols-outlined text-sm">shield</span> Super Admin CRM
          </span>
          <span class="text-xs text-gray-400 font-medium">Logged in as: <strong id="admin-user-email" class="text-gray-700">admin@credifycapital.in</strong></span>
        </div>
        <h1 class="text-2xl font-extrabold text-primary tracking-tight mt-1">Loan Origination &amp; Bank Routing Desk</h1>
        <p class="text-xs text-gray-500 mt-0.5">Manage customer leads, route applications to partner banks (Kotak, ICICI, HDFC), and monitor inquiries.</p>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto">
        <a href="/api/admin/export-csv" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition">
          <span class="material-symbols-outlined text-sm">download</span> Export Leads to CSV
        </a>
        <button onclick="handleAdminLogout()" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold px-4 py-2.5 rounded-xl transition">
          <span class="material-symbols-outlined text-sm">logout</span> Sign Out
        </button>
      </div>
    </div>

    <!-- DASHBOARD STATS OVERVIEW -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1 -->
      <div class="bg-white border border-outline-variant/30 rounded-2xl p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">assignment</span>
        </div>
        <div>
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Total Applications</p>
          <p id="stat-leads-count" class="text-2xl font-extrabold text-primary">0</p>
          <span class="text-[10px] text-gray-400" id="stat-leads-vol">₹0 Volume</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white border border-outline-variant/30 rounded-2xl p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 bg-blue-50 text-blue-700 rounded-xl flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Routed to Banks</p>
          <p id="stat-bank-count" class="text-2xl font-extrabold text-blue-900">0</p>
          <span class="text-[10px] text-blue-600">Kotak, ICICI, HDFC, etc.</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-white border border-outline-variant/30 rounded-2xl p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 bg-emerald-50 text-emerald-800 rounded-xl flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">check_circle</span>
        </div>
        <div>
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Disbursed Loans</p>
          <p id="stat-disbursed-count" class="text-2xl font-extrabold text-emerald-900">0</p>
          <span class="text-[10px] text-emerald-700" id="stat-disbursed-vol">₹0 Disbursed</span>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-white border border-outline-variant/30 rounded-2xl p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 bg-amber-50 text-amber-800 rounded-xl flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">forum</span>
        </div>
        <div>
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Website Inquiries</p>
          <p id="stat-contact-count" class="text-2xl font-extrabold text-amber-900">0</p>
          <span class="text-[10px] text-amber-700">Contact messages</span>
        </div>
      </div>
    </div>

    <!-- TABS CONTROLLER -->
    <div class="border-b border-outline-variant/30">
      <div class="flex gap-2" role="tablist">
        <button id="tab-leads" onclick="switchTab('leads')" class="py-3 px-4 border-b-2 border-primary font-bold text-sm text-primary transition-all flex items-center gap-2" role="tab">
          <span class="material-symbols-outlined text-lg">assignment</span> Loan Applications &amp; Bank Routing
        </button>
        <button id="tab-contacts" onclick="switchTab('contacts')" class="py-3 px-4 border-b-2 border-transparent font-semibold text-sm text-gray-500 hover:text-primary hover:border-gray-300 transition-all flex items-center gap-2" role="tab">
          <span class="material-symbols-outlined text-lg">forum</span> Contact Messages
        </button>
        <button id="tab-partners" onclick="switchTab('partners')" class="py-3 px-4 border-b-2 border-transparent font-semibold text-sm text-gray-500 hover:text-primary hover:border-gray-300 transition-all flex items-center gap-2" role="tab">
          <span class="material-symbols-outlined text-lg">group_add</span> DSA Partners Network
        </button>
      </div>
    </div>

    <!-- CONTENT MODULES -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl shadow-sm overflow-hidden min-h-[450px] flex flex-col justify-between">
      
      <!-- ACTION PANEL (FILTER & SEARCH) -->
      <div class="p-4 border-b border-outline-variant/20 bg-gray-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto flex-grow max-w-2xl">
          <div class="relative w-full sm:w-80">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-lg">search</span>
            <input type="text" id="search-input" oninput="handleFilterChange()" class="w-full pl-10 pr-4 py-2 rounded-xl border-gray-300 focus:ring-2 focus:ring-primary/20 focus:border-primary text-xs font-medium" placeholder="Search by name, phone, email, city, ID...">
          </div>
          
          <select id="status-filter" onchange="handleFilterChange()" class="w-full sm:w-auto rounded-xl border-gray-300 text-xs py-2 focus:ring-primary/20">
            <option value="ALL">All Statuses</option>
            <option value="New Lead">New Leads</option>
            <option value="Under Review">Under Review</option>
            <option value="Forwarded to Bank">Forwarded to Bank</option>
            <option value="Sanctioned">Sanctioned</option>
            <option value="Disbursed">Disbursed</option>
            <option value="Rejected">Rejected</option>
          </select>

          <select id="bank-filter" onchange="handleFilterChange()" class="w-full sm:w-auto rounded-xl border-gray-300 text-xs py-2 focus:ring-primary/20">
            <option value="ALL">All Banks</option>
            <option value="Kotak Mahindra Bank">Kotak Mahindra</option>
            <option value="ICICI Bank">ICICI Bank</option>
            <option value="HDFC Bank">HDFC Bank</option>
            <option value="Tata Capital">Tata Capital</option>
            <option value="Bajaj Finserv">Bajaj Finserv</option>
            <option value="Axis Bank">Axis Bank</option>
            <option value="Unassigned">Unassigned</option>
          </select>
        </div>

        <div class="text-xs text-gray-400 font-bold tracking-wide" id="record-count-display">
          Showing 0 records
        </div>
      </div>

      <!-- LOAN APPLICATIONS VIEW (LEADS) -->
      <div id="view-leads" class="tab-view block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-outline-variant/20 text-[11px] font-bold text-gray-400 uppercase tracking-wider">
              <th class="px-5 py-3.5">ID &amp; Applicant</th>
              <th class="px-5 py-3.5">Contact Details</th>
              <th class="px-5 py-3.5">Loan &amp; Financials</th>
              <th class="px-5 py-3.5">Assigned Bank</th>
              <th class="px-5 py-3.5">Current Status</th>
              <th class="px-5 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="table-leads-body" class="divide-y divide-gray-100 text-xs">
            <!-- Dynamic rows populated via JS -->
          </tbody>
        </table>
      </div>

      <!-- CONTACT MESSAGES VIEW -->
      <div id="view-contacts" class="tab-view hidden overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-outline-variant/20 text-[11px] font-bold text-gray-400 uppercase tracking-wider">
              <th class="px-5 py-3.5">Sender Details</th>
              <th class="px-5 py-3.5">Purpose &amp; Product</th>
              <th class="px-5 py-3.5">Message Content</th>
              <th class="px-5 py-3.5">Date Received</th>
              <th class="px-5 py-3.5 text-right">Direct Action</th>
            </tr>
          </thead>
          <tbody id="table-contacts-body" class="divide-y divide-gray-100 text-xs">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>

      <!-- PARTNER APPLICATIONS VIEW -->
      <div id="view-partners" class="tab-view hidden overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-outline-variant/20 text-[11px] font-bold text-gray-400 uppercase tracking-wider">
              <th class="px-5 py-3.5">Partner Agent</th>
              <th class="px-5 py-3.5">Agency &amp; City</th>
              <th class="px-5 py-3.5">Contact Details</th>
              <th class="px-5 py-3.5">DSA Partner Code</th>
              <th class="px-5 py-3.5">Status</th>
              <th class="px-5 py-3.5">Joined Date</th>
            </tr>
          </thead>
          <tbody id="table-partners-body" class="divide-y divide-gray-100 text-xs">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>

      <!-- EMPTY STATE FALLBACK -->
      <div id="empty-state" class="hidden flex-col items-center justify-center p-16 text-center">
        <span class="material-symbols-outlined text-5xl text-gray-300 mb-3">folder_open</span>
        <h3 class="font-bold text-primary text-sm">No Matching Entries Found</h3>
        <p class="text-gray-500 text-xs mt-1">Try resetting your search filter options</p>
      </div>

    </div>
  </main>

  <!-- MODAL: ASSIGN BANK & UPDATE STATUS -->
  <div id="bank-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl animate-fade-in relative">
      <div class="flex justify-between items-start border-b border-gray-100 pb-3">
        <div>
          <h3 class="font-extrabold text-base text-primary">Route Lead to Partner Bank</h3>
          <p class="text-xs text-gray-500" id="modal-lead-title">Lead ID: CC-APP-0000</p>
        </div>
        <button onclick="closeBankModal()" class="text-gray-400 hover:text-gray-600">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <form id="bank-routing-form" onsubmit="saveBankAssignment(event)" class="space-y-4 text-xs">
        <input type="hidden" id="modal-lead-id">

        <div>
          <label class="block font-bold text-gray-700 uppercase tracking-wide mb-1">Select Partner Bank / Lender</label>
          <select id="modal-bank-select" required class="w-full rounded-lg border-gray-300 py-2 text-xs focus:ring-primary/20">
            <option value="Kotak Mahindra Bank">Kotak Mahindra Bank (SME &amp; Business Loans)</option>
            <option value="ICICI Bank">ICICI Bank (InstaBIZ &amp; Personal Loans)</option>
            <option value="HDFC Bank">HDFC Bank (Commercial &amp; Retail Banking)</option>
            <option value="Tata Capital">Tata Capital Financial Services</option>
            <option value="Bajaj Finserv">Bajaj Finserv (MSME Schemes)</option>
            <option value="Axis Bank">Axis Bank Commercial Desk</option>
            <option value="Yes Bank">Yes Bank Business Banking</option>
            <option value="Unassigned">Unassigned (Under Credify Review)</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 uppercase tracking-wide mb-1">Lead Lifecycle Status</label>
          <select id="modal-status-select" required class="w-full rounded-lg border-gray-300 py-2 text-xs focus:ring-primary/20">
            <option value="New Lead">New Lead (Fresh Application)</option>
            <option value="Under Review">Under Review (Checking Documents/CIBIL)</option>
            <option value="Forwarded to Bank">Forwarded to Bank (LOS Uploaded)</option>
            <option value="Sanctioned">Sanctioned (Offer Letter Issued)</option>
            <option value="Disbursed">Disbursed (Funds Settled)</option>
            <option value="Rejected">Rejected (Ineligible / Policy Issue)</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 uppercase tracking-wide mb-1">Bank RM / Credit Officer Name &amp; Contact</label>
          <input type="text" id="modal-rm-input" class="w-full rounded-lg border-gray-300 py-2 text-xs focus:ring-primary/20" placeholder="e.g. Ramesh Kumar (Kotak SME Desk, 9876543210)">
        </div>

        <div>
          <label class="block font-bold text-gray-700 uppercase tracking-wide mb-1">Internal Operations Notes</label>
          <textarea id="modal-notes-input" rows="3" class="w-full rounded-lg border-gray-300 py-2 text-xs focus:ring-primary/20" placeholder="e.g. GST returns match 50L criteria. Forwarded to Kotak branch credit manager on 22-Aug."></textarea>
        </div>

        <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
          <button type="button" onclick="closeBankModal()" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg font-bold">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary/95 text-white rounded-lg font-bold shadow">Save &amp; Update Lead</button>
        </div>
      </form>
    </div>
  </div>

  <!-- FOOTER -->
  <%- include('../partials/footer') %>

  <!-- TOAST CONTAINER -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- SCRIPT ENGINE -->
  <script nonce="<%= nonce %>">
    let leadsData = [];
    let contactsData = [];
    let partnersData = [];
    let currentTab = 'leads';

    // Toast helper
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `flex items-center gap-2 px-4 py-3 rounded-xl text-white text-xs font-bold shadow-lg transform translate-y-2 opacity-0 transition-all duration-300 pointer-events-auto ${
        type === 'error' ? 'bg-secondary' : 'bg-primary'
      }`;
      const icon = type === 'error' ? 'error' : 'check_circle';
      toast.innerHTML = `<span class="material-symbols-outlined text-sm">${icon}</span> <span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 50);
      setTimeout(() => {
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Check Auth
    const token = localStorage.getItem('credify_admin_token');
    if (!token) {
      window.location.href = "admin-login.html";
    } else {
      const adminEmail = localStorage.getItem('credify_admin_email') || 'amitkumartrp321@gmail.com';
      document.getElementById('admin-user-email').textContent = adminEmail;
      fetchDashboardData();
    }

    function handleAdminLogout() {
      localStorage.removeItem('credify_admin_token');
      localStorage.removeItem('credify_admin_email');
      localStorage.removeItem('credify_admin_name');
      showToast('Signed out of Administrator CRM');
      setTimeout(() => {
        window.location.href = "admin-login.html";
      }, 500);
    }

    // Fetch all CRM databases
    async function fetchDashboardData() {
      try {
        const [resLeads, resContacts, resPartners] = await Promise.all([
          fetch('/api/admin/leads'),
          fetch('/api/admin/contacts'),
          fetch('/api/admin/partners')
        ]);

        const leadsJson = await resLeads.json();
        const contactsJson = await resContacts.json();
        const partnersJson = await resPartners.json();

        leadsData = (leadsJson && leadsJson.leads) || [];
        contactsData = (contactsJson && contactsJson.contacts) || [];
        partnersData = (partnersJson && partnersJson.partners) || [];

        renderStats();
        renderTabContent();
      } catch (err) {
        console.error('Error fetching data:', err);
        showToast('Error loading CRM records.', 'error');
      }
    }

    function renderStats() {
      document.getElementById('stat-leads-count').textContent = leadsData.length;
      document.getElementById('stat-contact-count').textContent = contactsData.length;

      const totalReqVol = leadsData.reduce((acc, l) => acc + (parseFloat(l.amount) || 0), 0);
      document.getElementById('stat-leads-vol').textContent = `₹${(totalReqVol / 100000).toFixed(1)}L Requested`;

      const routedToBank = leadsData.filter(l => l.assignedBank && l.assignedBank !== 'Unassigned').length;
      document.getElementById('stat-bank-count').textContent = routedToBank;

      const disbursedList = leadsData.filter(l => l.status === 'Disbursed');
      const disbursedVol = disbursedList.reduce((acc, l) => acc + (parseFloat(l.amount) || 0), 0);
      document.getElementById('stat-disbursed-count').textContent = disbursedList.length;
      document.getElementById('stat-disbursed-vol').textContent = `₹${(disbursedVol / 100000).toFixed(1)}L Disbursed`;
    }

    function switchTab(tab) {
      currentTab = tab;
      const tabs = ['leads', 'contacts', 'partners'];
      
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        const view = document.getElementById(`view-${t}`);
        if (t === tab) {
          btn.className = "py-3 px-4 border-b-2 border-primary font-bold text-sm text-primary transition-all flex items-center gap-2";
          view.classList.remove('hidden');
        } else {
          btn.className = "py-3 px-4 border-b-2 border-transparent font-semibold text-sm text-gray-500 hover:text-primary hover:border-gray-300 transition-all flex items-center gap-2";
          view.classList.add('hidden');
        }
      });

      handleFilterChange();
    }

    function handleFilterChange() {
      renderTabContent();
    }

    function renderTabContent() {
      const searchVal = (document.getElementById('search-input').value || '').toLowerCase().trim();
      const statusFilter = document.getElementById('status-filter').value;
      const bankFilter = document.getElementById('bank-filter').value;
      const emptyState = document.getElementById('empty-state');

      if (currentTab === 'leads') {
        const tbody = document.getElementById('table-leads-body');
        const filtered = leadsData.filter(l => {
          const matchSearch = !searchVal || 
            (l.name && l.name.toLowerCase().includes(searchVal)) ||
            (l.phone && l.phone.includes(searchVal)) ||
            (l.email && l.email.toLowerCase().includes(searchVal)) ||
            (l.city && l.city.toLowerCase().includes(searchVal)) ||
            (l.id && l.id.toLowerCase().includes(searchVal)) ||
            (l.product && l.product.toLowerCase().includes(searchVal));

          const matchStatus = statusFilter === 'ALL' || l.status === statusFilter;
          const matchBank = bankFilter === 'ALL' || l.assignedBank === bankFilter;

          return matchSearch && matchStatus && matchBank;
        });

        document.getElementById('record-count-display').textContent = `Showing ${filtered.length} of ${leadsData.length} leads`;

        if (filtered.length === 0) {
          tbody.innerHTML = '';
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          return;
        }

        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        const statusBadges = {
          'New Lead': 'bg-gray-100 text-gray-700 border-gray-200',
          'Under Review': 'bg-amber-100 text-amber-800 border-amber-200',
          'Forwarded to Bank': 'bg-blue-100 text-blue-800 border-blue-200',
          'Sanctioned': 'bg-indigo-100 text-indigo-800 border-indigo-200',
          'Disbursed': 'bg-emerald-100 text-emerald-800 border-emerald-200',
          'Rejected': 'bg-red-100 text-red-800 border-red-200'
        };

        tbody.innerHTML = filtered.map(lead => `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-5 py-4">
              <strong class="font-extrabold text-primary block">${lead.name}</strong>
              <span class="font-mono text-[10px] text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded">${lead.id}</span>
              ${lead.source === 'partner_referral' ? `<span class="inline-block text-[9px] font-bold text-amber-700 bg-amber-50 border border-amber-200 px-1 rounded ml-1">Partner: ${lead.referredByPartnerName || 'DSA'}</span>` : ''}
            </td>
            <td class="px-5 py-4 space-y-0.5">
              <div><a href="tel:+91${lead.phone}" class="font-semibold text-primary hover:underline">+91 ${lead.phone}</a></div>
              <div class="text-gray-400 text-[11px]">${lead.email || 'N/A'}</div>
              <div class="text-gray-500 text-[11px] font-medium"><span class="material-symbols-outlined text-[11px] align-middle">location_on</span> ${lead.city || 'India'}</div>
            </td>
            <td class="px-5 py-4 space-y-0.5">
              <div class="font-extrabold text-emerald-700 text-sm">₹${(parseFloat(lead.amount) || 0).toLocaleString('en-IN')}</div>
              <div class="text-gray-600 font-medium">${lead.product} &bull; ${lead.tenure}M</div>
              <div class="text-gray-400 text-[10px]">Income: ₹${(parseFloat(lead.income) || 0).toLocaleString('en-IN')} &bull; CIBIL: <strong class="text-gray-700">${lead.cibil || 'N/A'}</strong></div>
            </td>
            <td class="px-5 py-4 space-y-1">
              ${lead.assignedBank && lead.assignedBank !== 'Unassigned' 
                ? `<span class="inline-flex items-center gap-1 font-bold text-blue-800 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md"><span class="material-symbols-outlined text-xs">account_balance</span> ${lead.assignedBank}</span>`
                : `<span class="text-gray-400 italic">Unassigned</span>`
              }
              ${lead.bankRM ? `<div class="text-[10px] text-gray-500">RM: ${lead.bankRM}</div>` : ''}
            </td>
            <td class="px-5 py-4">
              <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold border ${statusBadges[lead.status] || 'bg-gray-100 text-gray-700'}">
                ${lead.status || 'New Lead'}
              </span>
            </td>
            <td class="px-5 py-4 text-right">
              <button onclick="openBankModal('${lead.id}')" class="inline-flex items-center gap-1 bg-primary hover:bg-primary/95 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-xs transition">
                <span class="material-symbols-outlined text-sm">edit_note</span> Route / Edit
              </button>
            </td>
          </tr>
        `).join('');
      } else if (currentTab === 'contacts') {
        const tbody = document.getElementById('table-contacts-body');
        const filtered = contactsData.filter(c => {
          const name = `${c.first_name || ''} ${c.last_name || ''}`.toLowerCase();
          return !searchVal || 
            name.includes(searchVal) || 
            (c.email_id && c.email_id.toLowerCase().includes(searchVal)) ||
            (c.message && c.message.toLowerCase().includes(searchVal));
        });

        document.getElementById('record-count-display').textContent = `Showing ${filtered.length} of ${contactsData.length} messages`;

        if (filtered.length === 0) {
          tbody.innerHTML = '';
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          return;
        }

        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        tbody.innerHTML = filtered.map(c => `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-5 py-4">
              <strong class="font-bold text-primary block">${c.first_name} ${c.last_name || ''}</strong>
              <a href="mailto:${c.email_id}" class="text-secondary hover:underline">${c.email_id}</a>
              <div class="text-[10px] text-gray-400">${c.city || 'N/A'}</div>
            </td>
            <td class="px-5 py-4">
              <span class="font-bold text-gray-700 block">${c.radios_option_purpose || 'General'}</span>
              <span class="text-[10px] text-gray-500">${c.product_type || 'N/A'}</span>
            </td>
            <td class="px-5 py-4 max-w-xs">
              <p class="text-gray-600 leading-relaxed">${c.message}</p>
            </td>
            <td class="px-5 py-4 text-gray-400 text-[11px]">
              ${c.createdAt ? c.createdAt.split('T')[0] : 'Recent'}
            </td>
            <td class="px-5 py-4 text-right">
              <a href="mailto:${c.email_id}?subject=Re: Credify Capital Enquiry" class="inline-flex items-center gap-1 bg-secondary text-white px-3 py-1.5 rounded-lg text-xs font-bold hover:brightness-110 transition">
                <span class="material-symbols-outlined text-sm">reply</span> Reply
              </a>
            </td>
          </tr>
        `).join('');
      } else if (currentTab === 'partners') {
        const tbody = document.getElementById('table-partners-body');
        const filtered = partnersData.filter(p => {
          return !searchVal || 
            (p.name && p.name.toLowerCase().includes(searchVal)) ||
            (p.agency && p.agency.toLowerCase().includes(searchVal)) ||
            (p.dsaCode && p.dsaCode.toLowerCase().includes(searchVal));
        });

        document.getElementById('record-count-display').textContent = `Showing ${filtered.length} of ${partnersData.length} partners`;

        if (filtered.length === 0) {
          tbody.innerHTML = '';
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          return;
        }

        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        tbody.innerHTML = filtered.map(p => `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-5 py-4">
              <strong class="font-bold text-primary block">${p.name}</strong>
            </td>
            <td class="px-5 py-4">
              <span class="font-medium text-gray-700 block">${p.agency || 'Independent'}</span>
              <span class="text-[10px] text-gray-400">${p.city || 'India'}</span>
            </td>
            <td class="px-5 py-4 space-y-0.5">
              <a href="tel:+91${p.mobile}" class="font-semibold text-primary hover:underline">+91 ${p.mobile}</a>
              <div class="text-[10px] text-gray-400">${p.email || 'N/A'}</div>
            </td>
            <td class="px-5 py-4">
              <span class="font-mono font-bold text-primary bg-primary/10 px-2 py-1 rounded text-[11px]">${p.dsaCode}</span>
            </td>
            <td class="px-5 py-4">
              <span class="font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full text-[10px]">Active DSA</span>
            </td>
            <td class="px-5 py-4 text-gray-400 text-[11px]">
              ${p.createdAt ? p.createdAt.split('T')[0] : 'Recent'}
            </td>
          </tr>
        `).join('');
      }
    }

    // Open Bank Routing Modal
    function openBankModal(leadId) {
      const lead = leadsData.find(l => l.id === leadId);
      if (!lead) return;

      document.getElementById('modal-lead-id').value = lead.id;
      document.getElementById('modal-lead-title').textContent = `${lead.name} (${lead.id}) – ₹${(parseFloat(lead.amount) || 0).toLocaleString('en-IN')} ${lead.product}`;
      document.getElementById('modal-bank-select').value = lead.assignedBank || 'Kotak Mahindra Bank';
      document.getElementById('modal-status-select').value = lead.status || 'New Lead';
      document.getElementById('modal-rm-input').value = lead.bankRM || '';
      document.getElementById('modal-notes-input').value = lead.notes || '';

      document.getElementById('bank-modal').classList.remove('hidden');
    }

    function closeBankModal() {
      document.getElementById('bank-modal').classList.add('hidden');
    }

    async function saveBankAssignment(e) {
      e.preventDefault();
      const id = document.getElementById('modal-lead-id').value;
      const assignedBank = document.getElementById('modal-bank-select').value;
      const status = document.getElementById('modal-status-select').value;
      const bankRM = document.getElementById('modal-rm-input').value.trim();
      const notes = document.getElementById('modal-notes-input').value.trim();

      try {
        const res = await fetch('/api/admin/update-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, assignedBank, status, bankRM, notes })
        });

        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed to update lead');

        showToast(`Lead ${id} routed to ${assignedBank}! Status: ${status}`);
        closeBankModal();
        fetchDashboardData();
      } catch (err) {
        showToast(err.message || 'Failed to update lead', 'error');
      }
    }
  </script>
</body>
</html>
