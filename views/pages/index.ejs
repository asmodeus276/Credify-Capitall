<script src="/js/credify-core.js"></script>
<script>
(function () {

  // --- Smooth scroll for "Check Free Credit Score" -> eligibility form ---
  document.querySelectorAll('.js-scroll-to-form').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var target = document.querySelector(link.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // --- Hero "Instant Eligibility Form" submit (previously onsubmit="return false;") ---
  var heroForm = document.getElementById('hero-eligibility-form');
  if (heroForm) {
    heroForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = heroForm.name.value.trim();
      var income = parseFloat(heroForm.income.value);
      var amount = parseFloat(heroForm.amount.value);
      var errorEl = document.getElementById('hero-form-error');

      if (!name || !(income > 0) || !(amount > 0)) {
        errorEl.classList.remove('hidden');
        return;
      }
      errorEl.classList.add('hidden');

      if (window.CredifyEngine) {
        window.CredifyEngine.setMonthlyIncome(income);
        window.CredifyEngine.setCalculatorInputs({ principal: amount, tenureMonths: 36 });
      }

      // Hand off to the full application form, pre-filled via CredifyEngine state.
      window.location.href = 'apply.html';
    });
  }
})();
</script>
</body></html>