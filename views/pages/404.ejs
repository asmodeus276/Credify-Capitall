<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>404 - Page Not Found | Credify Capital</title>
<meta name="description" content="The page you are looking for does not exist.">
<link rel="shortcut icon" href="/img/favicon.ico">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/tailwind-built.css">
</head>
<body class="bg-background text-on-background font-body-md pt-[64px] lg:pt-[116px] min-h-screen flex flex-col">
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center p-4">
  <div class="max-w-xl w-full text-center space-y-6 py-16">
    <div class="inline-flex justify-center items-center bg-red-100 text-red-600 rounded-full h-24 w-24 mb-4">
      <span class="material-symbols-outlined text-5xl">error</span>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-on-background">404</h1>
    <h2 class="text-2xl font-bold text-on-background">Page Not Found</h2>
    <p class="text-on-surface-variant text-lg">
      Sorry, the page you are looking for doesn't exist or has been moved.
    </p>
    <div class="pt-6">
      <a href="/" class="bg-primary text-on-primary px-8 py-3 rounded-full font-bold shadow-md hover:bg-primary/90 transition-all active:scale-95 inline-flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">home</span>
        Return to Home
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
